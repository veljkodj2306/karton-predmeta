<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

    <changeSet id="005-create-predmet-nastavnici-table" author="student">
        <createTable tableName="predmet_nastavnici">
            <column name="predmet_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="nastavnik" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey tableName="predmet_nastavnici"
                       columnNames="predmet_id,nastavnik"
                       constraintName="pk_predmet_nastavnici"/>

        <addForeignKeyConstraint
                baseTableName="predmet_nastavnici"
                baseColumnNames="predmet_id"
                referencedTableName="predmet"
                referencedColumnNames="id"
                constraintName="fk_predmet_nastavnici_predmet"/>
    </changeSet>

</databaseChangeLog>
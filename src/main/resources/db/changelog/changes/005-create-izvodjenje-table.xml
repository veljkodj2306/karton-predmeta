<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
           http://www.liquibase.org/xml/ns/dbchangelog
           http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

    <changeSet id="005-create-izvodjenje-table" author="veljko">
        <createTable tableName="izvodjenje">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="oblik_nastave" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="predmet_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="nastavnik_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="izvodjenje"
                baseColumnNames="predmet_id"
                referencedTableName="predmet"
                referencedColumnNames="id"
                constraintName="fk_izvodjenje_predmet"/>

        <addForeignKeyConstraint
                baseTableName="izvodjenje"
                baseColumnNames="nastavnik_id"
                referencedTableName="nastavnik"
                referencedColumnNames="id"
                constraintName="fk_izvodjenje_nastavnik"/>
    </changeSet>

</databaseChangeLog>